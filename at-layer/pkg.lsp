(@::def-pkg '((:NAME . "at-layer")
        (:FULL-NAME . "@lisp图层")
        (:AUTHOR . "VitalGG")
        (:EMAIL . "vitalgg@gmail.com")
        (:VERSION . "1.2.16")
        (:DESCRIPTION . "@lisp图层工具：功能包括图层的开关，锁定/解锁、冻结/解冻之类的。")
        (:CATEGORY . "通用")
        (:URL . "http://atlisp.cn")
        (:OPEN-SOURCE . 0)
        (:FREE . T)
        (:REQUIRED . "base")
        (:COMMANDS
        ((:NAME . "@layer:ai-lock")
         (:LABEL . "锁定对象")
         (:PARAMS . "ents:图元或选择集")
         (:COMMAND . "(@layer:ai-lock ${ents})")
         (:INTERACTIVE . nil)
         (:DESCRIPTION . "按 xdata 标记锁定实体"))
        ((:NAME . "@layer:ai-unlock")
         (:LABEL . "解锁对象")
         (:PARAMS . "ents:图元或选择集")
         (:COMMAND . "(@layer:ai-unlock ${ents})")
         (:INTERACTIVE . nil)
         (:DESCRIPTION . "解锁被 ai-lock 标记的实体"))
        ((:NAME . "@layer:ai-hide")
         (:LABEL . "隐藏对象")
         (:PARAMS . "ents:图元或选择集")
         (:COMMAND . "(@layer:ai-hide ${ents})")
         (:INTERACTIVE . nil)
         (:DESCRIPTION . "隐藏指定实体（不删图）"))
        ((:NAME . "@layer:ai-by-color")
         (:LABEL . "按颜色分层")
         (:PARAMS . "ents:图元或选择集;prefix:图层前缀")
         (:COMMAND . "(@layer:ai-by-color ${ents} ${prefix})")
         (:INTERACTIVE . nil)
         (:DESCRIPTION . "按实体颜色把它们移到 前缀-颜色 图层")))
        (:FILES "at-layer"
            "layers-ext"
            "layer-create")))
