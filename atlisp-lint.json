{
  "locale": "zh",
  "source": {
    "globs": ["**/*.lsp"],
    "exclude": ["**/node_modules/**", "**/vendor/**", "**/.git/**"]
  },
  "checks": {
    "parens": "error",
    "encoding": "error",
    "cl_syntax": "warn",
    "quit_exit": "error",
    "command_shell": "warn",
    "startapp": "warn",
    "vl_registry_write": "off",
    "vlax_without_loading": "info",
    "token_in_url": "warn",
    "open_without_close": "warn",
    "bare_function_names": "off",
    "line_length": "warn",
    "function_complexity": "warn",
    "parameter_naming": "warn",
    "unused_variable": "warn",
    "missing_doc": "warn",
    "trailing_whitespace": "warn",
    "module_registration": "off",
    "namespace_header": "off",
    "unused_parameter": "warn",
    "constant_condition": "warn",
    "redundant_progn": "warn",
    "empty_branch": "warn",
    "unused_let_binding": "warn",
    "recursive_call": "warn",
    "variable_shadow": "warn",
    "unused_local_fun": "warn",
    "redundant_quotes": "warn",
    "trailing_paren": "warn",
    "empty_comment": "warn",
    "redundant_setq": "warn",
    "redundant_nil_else": "warn",
    "single_arg_and_or": "warn",
    "redundant_let": "warn",
    "self_compare": "warn",
    "misplaced_else": "warn",
    "quote_vs_function": "warn",
    "commented_code": "warn",
    "double_not": "warn",
    "setq_single_arg": "warn",
    "assoc_without_cdr": "info",
    "identical_branches": "warn",
    "while_constant": "warn",
    "cond_duplicate": "warn",
    "duplicate_defun": "warn",
    "dangling_defun": "warn",
    "missing_export": "warn",
    "unused_package_dep": "warn",
    "error_handling": "warn",
    "global_naming": "warn",
    "extra_parens": "warn",
    "arg_count": "error",
    "builtin_arg_count": "error",
    "strcat_or_arg": "error",
    "strcat_usage": "warn",
    "cond_simplify": "warn",
    "quote_style": "warn",
    "eq_usage": "warn",
    "lambda_syntax": "off",
    "comment_style": "warn",
    "empty_catch": "info",
    "nth_usage": "info",
    "append_single": "warn",
    "setq_multiple": "warn",
    "format_indent": "off",
    "function_order": "off",
    "magic_number": "info",
    "mixed_indent": "warn",
    "long_function_call": "off",
    "no_return": "warn",
    "shadow_builtin": "warn",
    "dynamic_doc": "warn",
    "loop_optimization": "off",
    "redundant_if": "warn",
    "undeclared_setq": "warn",
    "unused_catch_result": "off",
    "string_concat_loop": "info",
    "if_without_else": "off",
    "redundant_list": "warn",
    "entget_in_loop": "warn",
    "promise_handler": "off",
    "module_cycle": "warn",
    "arg_count_project": "warn",
    "redundant_entmake": "warn",
    "missing_princ": "warn",
    "global_function_naming": "info"
  },
  "line_length": {
    "max": 200,
    "tab_width": 2
  },
  "function_complexity": {
    "max_lines": 300,
    "max_nesting": 30
  },
  "cl_syntax": {
    "keywords": ["&key"]
  },
  "dangerous_calls": {
    "quit": "error",
    "exit": "error",
    "command_shell": "warn",
    "startapp": "warn",
    "vl_registry_write": "off"
  },
  "module_registration": {
    "severity": "off",
    "patterns": [],
    "dirs": ["modules"]
  },
  "namespace_header": {
    "severity": "off",
    "package": "",
    "deps": [],
    "search_lines": 15
  },
  "bare_function_names": {
    "allowlist": ["T", "nil"],
    "namespace_pattern": "^[a-z]+:"
  },
  "sbcl": {
    "walk_exclude": [".vscode", "vendor", ".git"],
    "defmacro_allow_files": ["compat-cl"]
  }
}
