;;;鐩稿叧鐭╅樀鍑芥暟;;;----------------------------------------------------;
;;; 鍚戦噺鐨勬ā(闀垮害)                                       ;
;;; Vector Norm - Lee Mac                               ;
;;; Args: v - vector in R^n                               ;
;;;----------------------------------------------------;
(defun matrix:norm ( v )
  "鍚戦噺鐨勬ā(闀垮害)"
  (sqrt (apply '+ (mapcar '* v v)))
)

