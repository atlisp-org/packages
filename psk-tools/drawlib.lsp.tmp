(setq $psk-block-base  '(0 0)
      $psk-block-angle 0.
)

;; P1 P3
;; P2 P4
(defun psk-draw-rectangle-inner	(p a l h / p1 p2 p3 p4)
  (setq	p1 (polar p (+ a $pi/2) (* h 0.5))
	p2 (polar p
		  (+ a $pi/2)
		  (* h -0.5)
	   )
	p3 (polar p1 a l)
	p4 (polar p2 a l)
  )
  (p-make-line p1 p2)
  (p-make-line p3 p4)
  (p-make-line p1 p3)
  (p-make-line p2 p4)
  (list p1 p2 p3 p4)
)
;; 鍒涘缓瀹絣 楂榟 鍘熺偣鍦ㄥ乏杈逛腑鐐逛笂鐨勭畝鍗曠煩褰